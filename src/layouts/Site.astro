---
// Gabarit commun à toutes les pages. Polices auto-hébergées (@fontsource) : aucun appel à Google.
import "@fontsource/pt-sans/400.css";
import "@fontsource/pt-sans/700.css";
import "@fontsource/pt-sans/400-italic.css";
import "@fontsource/antonio/500.css";
import "@fontsource/antonio/700.css";
import "@fontsource/fraunces/500.css";
import "@fontsource/fraunces/400-italic.css";
import "@fontsource/caveat-brush/400.css";
import "../styles/site.css";

interface Props {
  titre: string;
  description: string;
  page: string;
}
const { titre, description, page } = Astro.props;
const ogImage = new URL("/images/affiche-pesticides.jpg", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: "/appel", label: "L'appel", pages: ["appel"] },
  { href: "/#demandes", label: "Nos demandes", pages: [] },
  { href: "/egalim", label: "EGalim", pages: ["egalim"] },
  { href: "/#agir", label: "Agir", pages: ["commander", "distribution", "rencontre"] },
  { href: "/elus", label: "Élu·es", pages: ["elus"] },
  { href: "/visuels", label: "Visuels", pages: ["visuels"] },
  { href: "/actualites", label: "Actualités", pages: ["actualites"] },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/images/logo-bca.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site">
      <div class="wrap row">
        <a class="logo" href="/" aria-label="Pas de pesticides pour nos enfants, accueil">
          <img src="/images/logo-bca.jpg" alt="" width="44" height="44" />
          <span>Pas de pesticides <b>pour nos enfants&nbsp;!</b></span>
        </a>
        <nav class="main" aria-label="Navigation principale">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.pages.includes(page) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="btn btn-yellow" href="/#signer">Je signe</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap cols">
        <div style="display:grid;gap:10px;align-content:start">
          <span class="brand">Pas de pesticides <b>pour nos enfants&nbsp;!</b></span>
          <p>Pétition citoyenne portée par Bio Consom'acteurs. 10 rue Beaumarchais, 93100 Montreuil.</p>
        </div>
        <div><h4>La campagne</h4><ul><li><a href="/appel">L'appel</a></li><li><a href="/#demandes">Nos demandes</a></li><li><a href="/egalim">La demande préalable EGalim</a></li><li><a href="/visuels">Visuels</a></li><li><a href="/actualites">Actualités</a></li><li><a href="/#signer">Signer</a></li></ul></div>
        <div><h4>Agir</h4><ul><li><a href="/commander">Commander du matériel</a></li><li><a href="/distribution">Organiser une distribution</a></li><li><a href="/rencontre">Rencontrer vos élu·es</a></li><li><a href="/elus">Élu·es et candidat·es</a></li></ul></div>
        <div><h4>Bio Consom'acteurs</h4><ul><li><a href="https://bioconsomacteurs.org" target="_blank" rel="noopener">Site de l'association ↗</a></li><li><a href="https://bioconsomacteurs.org" target="_blank" rel="noopener">Adhérer ↗</a></li><li><a href="https://bioconsomacteurs.org" target="_blank" rel="noopener">Faire un don ↗</a></li><li><a href="mailto:contact@bioconsomacteurs.org">contact@bioconsomacteurs.org</a></li></ul></div>
      </div>
      <div class="wrap legal">
        <span>© 2026 Bio Consom'acteurs · pasdepesticidespournosenfants.net</span>
        <span><a href="/mentions-legales">Mentions légales</a> · <a href="/confidentialite">Politique de confidentialité</a></span>
      </div>
    </footer>

    <script src="../scripts/site.js"></script>
  </body>
</html>
