---
// Gabarit commun à toutes les pages. Polices auto-hébergées (@fontsource) : aucun appel à Google.
import "@fontsource/pt-sans/400.css";
import "@fontsource/pt-sans/700.css";
import "@fontsource/pt-sans/400-italic.css";
import "@fontsource/antonio/500.css";
import "@fontsource/antonio/700.css";
import "../styles/site.css";

interface Props {
  titre: string;
  description: string;
  page: string;
}
const { titre, description, page } = Astro.props;
const ogImage = new URL("/kit/partage.png", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: "/appel", label: "L'appel", pages: ["appel"] },
  { href: "/appel#a-demandes", label: "Nos demandes", pages: [] },
  { href: "/#agir", label: "Agir", pages: ["relayer", "distribution", "kit"] },
  { href: "/actualites", label: "Actualités", pages: ["actualites"] },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4F7F57" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site">
      <div class="wrap row">
        <a class="logo" href="/" aria-label="Pas de pesticides pour nos enfants, accueil">Pas de pesticides <b>pour nos enfants&nbsp;!</b></a>
        <nav class="main" aria-label="Navigation principale">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.pages.includes(page) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <a class="btn btn-corail" href="/#signer">Je signe</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap cols">
        <div style="display:grid;gap:10px;align-content:start">
          <span class="brand">Pas de pesticides <b>pour nos enfants&nbsp;!</b></span>
          <p>Une pétition de Bio Consom'acteurs. 10 rue Beaumarchais, 93100 Montreuil.</p>
        </div>
        <div><h4>La pétition</h4><ul><li><a href="/appel">L'appel</a></li><li><a href="/appel#a-demandes">Nos demandes</a></li><li><a href="/#signer">Signer</a></li><li><a href="/actualites">Actualités</a></li></ul></div>
        <div><h4>Agir</h4><ul><li><a href="/relayer">Relayer la pétition</a></li><li><a href="/distribution">Organiser une table</a></li><li><a href="/kit">Imprimer le kit</a></li></ul></div>
        <div><h4>Bio Consom'acteurs</h4><ul><li><a href="https://bioconsomacteurs.org" target="_blank" rel="noopener">Site de l'association ↗</a></li><li><a href="https://bioconsomacteurs.org/projets/plusdebiosurmonplateau/" target="_blank" rel="noopener">Plus de Bio sur mon plateau ↗</a></li><li><a href="https://www.helloasso.com/associations/bio-consom-acteurs/formulaires/1" target="_blank" rel="noopener">Faire un don ↗</a></li><li><a href="mailto:contact@bioconsomacteurs.org">contact@bioconsomacteurs.org</a></li></ul></div>
      </div>
      <div class="wrap legal">
        <span>© 2026 Bio Consom'acteurs · pasdepesticidespournosenfants.net</span>
        <span><a href="/mentions-legales">Mentions légales</a> · <a href="/confidentialite">Politique de confidentialité</a></span>
      </div>
    </footer>

    <script src="../scripts/site.js"></script>
  </body>
</html>
