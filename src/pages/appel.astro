    <div class="wrap">
      <p class="eyebrow">Le texte de la pétition</p>
      <h1>Pas de pesticides <em>pour nos enfants</em></h1>
      <div class="ctas" style="margin-top:6px"><a class="btn btn-noir" href="/#signer">Je signe</a></div>
    </div>
