---
import Site from '../layouts/Site.astro';
import { actus } from '../data/actualites';
---

<Site titre="Actualités · Pas de pesticides pour nos enfants" description="L'actualité de Bio Consom'acteurs et de ses alliés contre l'exposition des enfants aux pesticides." page="actualites">
<section class="page-hero on-vert">
    <div class="wrap">
      <p class="eyebrow">Actualités</p>
      <h1>L'actualité de Bio Consom'acteurs <em>et de ses alliés</em></h1>
      <p class="lead">Les actions de Bio Consom'acteurs contre l'exposition de nos enfants aux pesticides, et celles des associations qui mènent la même lutte.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="news">
        {actus.map((a) => (
          <a class={a.bca ? 'news-card de-bca' : 'news-card'} href={a.url} target="_blank" rel="noopener">
            <span class="bandeau">{a.source}</span>
            <div class="body"><span class="src">{a.date}</span><h3>{a.titre}</h3><span class="more">Lire l'article ↗</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Site>
